<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent — daily holdout-readiness probe.

  Companion to com.polyterminal.kalshi-collector.plist: the collector AGENT keeps
  data flowing; this READINESS agent reads that data once a day and reports whether
  the 2026-06-02 → 2026-06-09 window is continuous_holdout_eligible yet. It is a
  periodic one-shot (StartCalendarInterval), NOT KeepAlive.

  Install:
    cp scripts/com.polyterminal.kalshi-readiness.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.polyterminal.kalshi-readiness.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.polyterminal.kalshi-readiness.plist

  Output: appended verdicts in ops/state/readiness-history.log; launchd stdio in
  ops/state/readiness-timer.{out,err}.log. PATH must include node+pnpm (see below).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polyterminal.kalshi-readiness</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aurascoper/Developer/polyterminal/apps/data-collector/scripts/readiness-cron.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aurascoper/Developer/polyterminal/apps/data-collector</string>

    <!-- Run once at load (verifies wiring; silent before the window opens),
         then every day at 09:05 local. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aurascoper/Developer/polyterminal/apps/data-collector/ops/state/readiness-timer.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aurascoper/Developer/polyterminal/apps/data-collector/ops/state/readiness-timer.err.log</string>
</dict>
</plist>
