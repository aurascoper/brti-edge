<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for the Polymarket data-collector.

  Layering: launchd keeps the SUPERVISOR alive across reboot / logout / panic;
  the supervisor (run-polymarket-collector.sh) keeps the COLLECTOR alive within
  a session (crash + stall restart) and holds caffeinate. launchd sends SIGTERM
  then SIGKILL after ExitTimeOut (15s > the 5s drain grace), so the gzip trailer
  always lands — no .drainbug.

  NOT INSTALLED BY DEFAULT — this file is written by Phase 0 but must be
  installed deliberately. Install (paths below are machine-specific — adjust
  if you move the repo):
    cp scripts/com.polyterminal.polymarket-collector.plist ~/Library/LaunchAgents/
    launchctl load   ~/Library/LaunchAgents/com.polyterminal.polymarket-collector.plist
    launchctl start  com.polyterminal.polymarket-collector
  Stop / remove:
    launchctl stop   com.polyterminal.polymarket-collector
    launchctl unload ~/Library/LaunchAgents/com.polyterminal.polymarket-collector.plist

  NOTE: launchd has a minimal PATH. The EnvironmentVariables/PATH below must
  contain your node + pnpm. Find them with `dirname "$(which pnpm)"` and
  `dirname "$(which node)"` and edit if different. No credentials are needed —
  the Polymarket CLOB market-data websocket is public; the supervisor still
  sources apps/data-collector/.env and the repo-root .env for PM_COLLECTOR_*
  overrides.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polyterminal.polymarket-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aurascoper/Developer/brti-edge/apps/data-collector/scripts/run-polymarket-collector.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aurascoper/Developer/brti-edge/apps/data-collector</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Don't relaunch faster than this if the supervisor itself dies. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Grace before launchd escalates SIGTERM -> SIGKILL. Must exceed the
         supervisor's GRACE_SECONDS (5s) so the drain completes. -->
    <key>ExitTimeOut</key>
    <integer>15</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aurascoper/Developer/brti-edge/apps/data-collector/ops/state/launchd-pm-collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aurascoper/Developer/brti-edge/apps/data-collector/ops/state/launchd-pm-collector.err.log</string>
</dict>
</plist>
