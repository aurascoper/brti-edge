# Pi host (system unit). Polymarket up/down tape archiver — credential-free,
# public CLOB market WS + Binance vision spot stream. Tape on /mnt/ssd.
# Modeled on kalshi-collector.service (same NTP hard gate + gzip stop drain).
[Unit]
Description=Polymarket up/down tape archiver (brti-edge)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
RequiresMountsFor=/mnt/ssd

[Service]
Type=simple
User=bonzos
WorkingDirectory=/home/bonzos/brti-edge/apps/data-collector
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PM_COLLECTOR_LOG_DIR=/mnt/ssd/polymarket/logs
# HARD clock gate — never write tape with an unsynced clock (RTC-less Pi).
ExecStartPre=/usr/bin/bash -c 'until timedatectl show -p NTPSynchronized --value | grep -qx yes; do sleep 5; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/bash /home/bonzos/brti-edge/apps/data-collector/scripts/run-polymarket-collector.sh
Restart=always
RestartSec=30
KillMode=mixed
# gzip trailer must flush on stop — a truncated hour file reads as a gap
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
