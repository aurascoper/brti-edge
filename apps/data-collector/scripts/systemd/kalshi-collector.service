# Pi host (system unit, NOT --user: network-online/time-sync targets only
# exist in the system manager). Install:
#   sudo cp *.service *.timer /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now kalshi-collector kalshi-worker
[Unit]
Description=Kalshi WS data collector (brti-edge)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=bonzos
WorkingDirectory=/home/bonzos/brti-edge/apps/data-collector
EnvironmentFile=/home/bonzos/.config/brti-edge/brti.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# HARD clock gate — target ordering fails open (chrony-wait times out and
# releases boot); this makes never-write-with-an-unsynced-clock a property
# of the service. Observed failure: RTC-less cold boot -> April clock ->
# unbound DNSSEC rejects everything -> DNS dead -> NTP names dead. Broken
# by the IP-literal chrony sources; this gate is the belt-and-braces.
ExecStartPre=/usr/bin/bash -c 'until timedatectl show -p NTPSynchronized --value | grep -qx yes; do sleep 5; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/bash /home/bonzos/brti-edge/apps/data-collector/scripts/run-collector-supervised.sh
Restart=always
RestartSec=30
KillMode=mixed
# gzip trailer must flush on stop — a truncated hour file reads as a gap
TimeoutStopSec=30
StandardOutput=append:/home/bonzos/brti-edge/apps/data-collector/ops/state/launchd-collector.out.log
StandardError=append:/home/bonzos/brti-edge/apps/data-collector/ops/state/launchd-collector.err.log
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
