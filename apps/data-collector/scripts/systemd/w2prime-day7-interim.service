[Unit]
Description=W2' day7-interim — mechanical close wrapper (never the bare scorer)

[Service]
Type=oneshot
User=bonzos
WorkingDirectory=/home/bonzos/brti-edge
EnvironmentFile=/home/bonzos/.config/brti-edge/brti.env
ExecStart=/usr/bin/python3 /home/bonzos/brti-edge/apps/market-worker/scripts/w2_close_check.py --since 2026-08-06T10:00:00Z --until 2026-08-13T10:00:00Z --interim --tag w2prime-instrument-20260806
StandardOutput=append:/home/bonzos/brti-edge/analysis/w2/w2prime-day7-interim-pi.txt
StandardError=append:/home/bonzos/brti-edge/analysis/w2/w2prime-day7-interim-pi.err
