EnvironmentFile=/home/bonzos/.config/brti-edge/brti.env
ExecStart=/usr/bin/python3 /home/bonzos/brti-edge/apps/market-worker/scripts/w2_close_check.py --since 2026-08-06T10:00:00Z --until 2026-08-20T10:00:00Z --tag w2prime-instrument-20260806
