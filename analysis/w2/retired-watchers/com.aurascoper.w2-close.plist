<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- W2 prereg §8 battery at window close — fires once at 2026-08-17T19:05Z
     (14:05 America/Chicago). Full report is sanctioned at close. Remove after:
     launchctl bootout gui/501/com.aurascoper.w2-close -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aurascoper.w2-close</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/aurascoper/Developer/brti-edge/apps/market-worker/scripts/w2_replay_scorer.py</string>
    <string>--since</string><string>2026-08-03T19:00:00Z</string>
    <string>--until</string><string>2026-08-17T19:00:00Z</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Month</key><integer>8</integer><key>Day</key><integer>17</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/aurascoper/Developer/brti-edge/analysis/w2/close-report.txt</string>
  <key>StandardErrorPath</key><string>/Users/aurascoper/Developer/brti-edge/analysis/w2/close-report.err</string>
</dict>
</plist>
